# Local development only. Copy to .env and replace the sample password.
# Never use these sample values in a shared or production environment.
CAMPUS_DB_HOST=127.0.0.1
CAMPUS_DB_PORT=5432
CAMPUS_DB_NAME=campus
CAMPUS_DB_USER=campus
CAMPUS_DB_PASSWORD=replace-with-local-development-password

# C is opt-in; configure approved policies and service credentials before enabling.
CAMPUS_C_ENABLED=false
# Paths are relative to backend/ locally, and /app in the backend container.
# CAMPUS_C_CONFIG_FILE=app/modules/m2_approval/examples/runtime.synthetic.json
# CAMPUS_RESOURCES_SERVICE_TOKEN=<set locally; never commit a real value>
# CAMPUS_M1_SERVICE_TOKEN=<only when M1 delivery is configured>
