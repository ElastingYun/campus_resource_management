# Local development only. Copy to .env and replace the sample password.
# Never use these sample values in a shared or production environment.
CAMPUS_DB_HOST=127.0.0.1
CAMPUS_DB_PORT=5432
CAMPUS_DB_NAME=campus
CAMPUS_DB_USER=campus
CAMPUS_DB_PASSWORD=replace-with-local-development-password

# M1 seat reservation (docs/a-m1-handbook.md). All optional for local development.
# CAMPUS_M1_TIMEZONE=Asia/Shanghai
# "dev-headers" trusts X-Dev-* request headers as identity: local machine only,
# never in a shared, test or production environment. Default: disabled.
# CAMPUS_M1_AUTH_MODE=disabled
# Check-in answers 503 until this is set; use a random value, never commit it.
# CAMPUS_M1_CHECKIN_CODE_SECRET=replace-with-a-random-local-secret
