# Copy to .env (never commit .env). Values below are safe local examples only.
DATABASE_URL=postgresql+psycopg://campus:campus@127.0.0.1:5432/campus
BUSINESS_TIMEZONE=Asia/Shanghai
# "dev-headers" trusts X-Dev-* request headers as identity. Local development
# only, until C's authentication is integrated. Never enable it in test/prod.
AUTH_MODE=dev-headers
# Secret used to derive each room's daily check-in code. Use a random value.
M1_CHECKIN_CODE_SECRET=change-me-local-only
