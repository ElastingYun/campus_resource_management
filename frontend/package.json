{
  "name": "campus-resource-management-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.integration.json --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.4.6",
    "jsdom": "27.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
